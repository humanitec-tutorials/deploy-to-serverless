# Humanitec Organization ID
humanitec_org_id="YOURVALUE"
# Universal prefix for all objects to create
object_prefix="cloudrun-guide-"
# Your Google Cloud project ID
gcp_project_id="YOURVALUE"
# Google Cloud region to use for resources, e.g. 'europe-west3'
gcp_region="YOURVALUE"
# Name of the Orchestrator secret store registration for Google Secret Manager
gsm_secret_store_name="YOURVALUE"

# How the runner authenticates against Google Cloud. One of:
# - "workload_identity_principal": GKE Workload Identity Federation, IAM roles granted directly
#   to the principal of the runner's Kubernetes service account. No Google service account needed
# - "workload_identity_service_account": GKE Workload Identity, the runner's Kubernetes service account
#   impersonates the Google service account set in gcp_deployer_service_account_name
# - "service_account_key": creates a key for the Google service account set in gcp_deployer_service_account_name
#   and hands it to the runner. Use for non-GKE clusters or GKE without Workload Identity
#   The key is stored in the local state. Protect the state file and destroy the setup when done
gcp_auth_mode="YOURVALUE"

# Name of the existing Google service account to be used for deploying into GCP, e.g. 'my-account'
# Not used with gcp_auth_mode="workload_identity_principal"
# gcp_deployer_service_account_name="YOURVALUE"

# Project ID of the GKE cluster running the Container Runner, which owns the Workload Identity pool
# Only used with gcp_auth_mode="workload_identity_principal". Defaults to gcp_project_id
# gke_project_id="YOURVALUE"

# Kubernetes namespace of the container runner
k8s_container_runner_namespace="humanitec-runner"
# Kubernetes service account for the container runner Jobs
k8s_container_runner_service_account="humanitec-runner"
# ID of the Resource Definition of type `k8s-cluster` that defines the runner cluster to use
k8s-runner-cluster-resource-definition-id="YOURVALUE"
# ID of the Resource Definition of type `agent` that defines the Humanitec Agent to use. Leave empty if not using an Agent"
agent-resource-definition-id="YOURVALUE"